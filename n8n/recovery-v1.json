        "jsCode": "function obj(v){if(typeof v==='string'){try{v=JSON.parse(v)}catch{return null}}return v!==null&&typeof v==='object'&&!Array.isArray(v)?v:null}\nconst suppliedStatus=$json.response_status??$json.statusCode;\nconst suppliedBody=$json.response_body??$json.body;\nconst roots=[obj(suppliedBody),obj($json.data),obj($json.response),obj($json)].filter(Boolean);\nconst candidates=[];for(const r of roots){for(const v of [r,obj(r.body),obj(r.data),obj(r.response),obj(r.json)]){if(v&&!candidates.includes(v))candidates.push(v)}}\nconst good=candidates.find(v=>JSON.stringify(Object.keys(v).sort())===JSON.stringify(['pending_retries','recovered_by_type','recovered_claims','schema_version','status','terminal_failures'])&&v.schema_version==='1'&&v.status==='COMPLETED'&&Number.isInteger(v.recovered_claims)&&Number.isInteger(v.pending_retries)&&Number.isInteger(v.terminal_failures)&&obj(v.recovered_by_type));\nif(Number(suppliedStatus)===200&&good){return {json:{response_status:200,response_body_json:JSON.stringify(good)}}}\nif($json.response_status){return {json:{response_status:$json.response_status,response_body_json:JSON.stringify($json.response_body)}}}\nreturn {json:{response_status:502,response_body_json:JSON.stringify({error_code:'INVALID_PRIMARY_RESPONSE',message:'The primary recovery response did not match the v1 contract.',retryable:true})}};"
